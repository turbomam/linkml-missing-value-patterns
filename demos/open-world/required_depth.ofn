Prefix(:=<https://example.org/demo/>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

# Every RequiredDepthSample has at least one depth. s3 is one, and no depth is asserted for it.
# An OWL reasoner calls this consistent: under the open-world assumption s3 has some depth that
# nobody wrote down.
Ontology(<https://example.org/demo/required_depth>
Declaration(Class(:RequiredDepthSample))
Declaration(DataProperty(:hasDepth))
Declaration(NamedIndividual(:s3))
SubClassOf(:RequiredDepthSample DataMinCardinality(1 :hasDepth))
ClassAssertion(:RequiredDepthSample :s3)
)
