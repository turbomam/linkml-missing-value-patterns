# base.ttl: shared individuals and a small axiom excerpt for every pattern file.
#
# Scenario: a patient and a health care provider participate in a health care encounter.
# A blood specimen is collected during the encounter. Each pNN file adds (or deliberately
# does not add) the blood glucose assay, its measurement datum, and its value specification.
#
# LinkML option: none (shared context).
#
# The TBox excerpt below copies only axioms read from the released ontologies on 2026-09-14
# (OBI 2026-07-27, COB 2025-12-15, plus OLS4 hierarchy for OBI, GENEPIO, IAO). It exists so that
# ROBOT/HermiT can show consistency behaviour without importing all of OBI. Subclass axioms
# marked "ancestor" state an OLS hierarchicalAncestors result, not necessarily a direct parent.
# Transitivity of part of / has part (RO) is deliberately NOT copied: see p06 for why.

@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:        <https://example.org/encounter/> .
@prefix BFO:       <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO:        <http://purl.obolibrary.org/obo/RO_> .
@prefix IAO:       <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI:       <http://purl.obolibrary.org/obo/OBI_> .
@prefix COB:       <http://purl.obolibrary.org/obo/COB_> .
@prefix OGMS:      <http://purl.obolibrary.org/obo/OGMS_> .
@prefix OMRSE:     <http://purl.obolibrary.org/obo/OMRSE_> .
@prefix GENEPIO:   <http://purl.obolibrary.org/obo/GENEPIO_> .
@prefix UO:        <http://purl.obolibrary.org/obo/UO_> .
@prefix NCIT:      <http://purl.obolibrary.org/obo/NCIT_> .
@prefix NCBITaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .

<https://example.org/encounter/base> a owl:Ontology ;
    rdfs:comment "Shared individuals for the missing-value RDF examples." .

########## Object properties ##########

BFO:0000050 a owl:ObjectProperty ; rdfs:label "part of" ; owl:inverseOf BFO:0000051 .
BFO:0000051 a owl:ObjectProperty ; rdfs:label "has part" .
RO:0000057  a owl:ObjectProperty ; rdfs:label "has participant" .
RO:0000087  a owl:ObjectProperty ; rdfs:label "has role" .
IAO:0000136 a owl:ObjectProperty ; rdfs:label "is about" .
IAO:0000039 a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label "has measurement unit label" .

# Domain axioms copied from OBI 2026-07-27 and COB 2025-12-15.
OBI:0000293 a owl:ObjectProperty ; rdfs:label "has specified input" ;
    rdfs:subPropertyOf RO:0000057 ; rdfs:domain COB:0000035 .
OBI:0000299 a owl:ObjectProperty ; rdfs:label "has specified output" ;
    rdfs:subPropertyOf RO:0000057 ; rdfs:domain COB:0000035 .

# Copied from OBI 2026-07-27.
OBI:0001938 a owl:ObjectProperty ; rdfs:label "has value specification" ;
    rdfs:subPropertyOf BFO:0000051 ; rdfs:domain IAO:0000030 ; rdfs:range OBI:0001933 .

# COB 2025-12-15 declares this property with a label only: no definition, domain, or range.
COB:0000085 a owl:ObjectProperty ; rdfs:label "intended plan process type" .

########## Data properties (copied from OBI 2026-07-27) ##########

OBI:0002135 a owl:DatatypeProperty ; rdfs:label "has specified value" ; rdfs:domain OBI:0001933 .
OBI:0001937 a owl:DatatypeProperty ; rdfs:label "has specified numeric value" ;
    rdfs:subPropertyOf OBI:0002135 ; rdfs:domain OBI:0001933 ; rdfs:range owl:real .

########## Classes ##########

OGMS:0000097 a owl:Class ; rdfs:label "health care encounter" .
OBI:0000093 a owl:Class ; rdfs:label "patient role" .
OMRSE:00000012 a owl:Class ; rdfs:label "health care provider role" .
NCBITaxon:9606 a owl:Class ; rdfs:label "Homo sapiens" .
OBI:0000655 a owl:Class ; rdfs:label "blood specimen" .

COB:0000082 a owl:Class ; rdfs:label "planned process" .
COB:0000035 a owl:Class ; rdfs:label "completely executed planned process" ;
    rdfs:subClassOf COB:0000082 ;
    owl:disjointWith COB:0000083 .          # present in both COB 2025-12-15 and OBI 2026-07-27
COB:0000083 a owl:Class ; rdfs:label "failed planned process" ; rdfs:subClassOf COB:0000082 .

OBI:1110095 a owl:Class ; rdfs:label "blood specimen collection" ;
    rdfs:subClassOf COB:0000035 .           # ancestor
OBI:0000070 a owl:Class ; rdfs:label "assay" ; rdfs:subClassOf COB:0000035 .   # ancestor
OBI:2100020 a owl:Class ; rdfs:label "glucose assay" ; rdfs:subClassOf OBI:0000070 .  # ancestor
OBI:0003040 a owl:Class ; rdfs:label "blood assay" .
OBI:2100072 a owl:Class ; rdfs:label "venous blood glucose assay" ;
    rdfs:subClassOf OBI:2100020 , OBI:0003040 .   # both direct parents per OLS
OBI:0003725 a owl:Class ; rdfs:label "survey administration assay" ; rdfs:subClassOf OBI:0000070 .

IAO:0000030 a owl:Class ; rdfs:label "information content entity" .
IAO:0000027 a owl:Class ; rdfs:label "data entity" ; rdfs:subClassOf IAO:0000030 .
IAO:0000109 a owl:Class ; rdfs:label "measurement datum" ; rdfs:subClassOf IAO:0000027 .
OBI:0000938 a owl:Class ; rdfs:label "categorical measurement datum" ; rdfs:subClassOf IAO:0000109 .
OBI:0001933 a owl:Class ; rdfs:label "value specification" ; rdfs:subClassOf IAO:0000030 .
OBI:0001931 a owl:Class ; rdfs:label "scalar value specification" ; rdfs:subClassOf OBI:0001933 .
OBI:0001930 a owl:Class ; rdfs:label "categorical value specification" ; rdfs:subClassOf OBI:0001933 .
OBI:0003549 a owl:Class ; rdfs:label "lower limit of detection" ; rdfs:subClassOf OBI:0001933 .

OBI:0002199 a owl:Class ; rdfs:label "reason for lack of data item" ; rdfs:subClassOf IAO:0000030 .

GENEPIO:0001850 a owl:Class ; rdfs:label "datum status" ; rdfs:subClassOf IAO:0000027 .
GENEPIO:0001618 a owl:Class ; rdfs:label "missing" ; rdfs:subClassOf GENEPIO:0001850 .
GENEPIO:0001619 a owl:Class ; rdfs:label "not applicable" ; rdfs:subClassOf GENEPIO:0001850 .
GENEPIO:0001620 a owl:Class ; rdfs:label "not collected" ; rdfs:subClassOf GENEPIO:0001850 .
GENEPIO:0001668 a owl:Class ; rdfs:label "not provided" ; rdfs:subClassOf GENEPIO:0001850 .
GENEPIO:0001810 a owl:Class ; rdfs:label "restricted access" ; rdfs:subClassOf GENEPIO:0001850 .
GENEPIO:0001662 a owl:Class ; rdfs:label "in process" ; rdfs:subClassOf GENEPIO:0001850 .
GENEPIO:0001851 a owl:Class ; rdfs:label "recorded" ; rdfs:subClassOf GENEPIO:0001850 .

NCIT:C79729 a owl:Class ; rdfs:label "Asked but Unknown" .

# UO units are punned: OLS lists UO:0010067 as both a class and an individual.
UO:0010067 a owl:NamedIndividual ; rdfs:label "milligram per deciliter" .

########## Individuals ##########

ex:patient1 a owl:NamedIndividual , NCBITaxon:9606 ;
    rdfs:label "patient 1" ;
    RO:0000087 ex:patientRole1 .
ex:patientRole1 a owl:NamedIndividual , OBI:0000093 .

ex:provider1 a owl:NamedIndividual , NCBITaxon:9606 ;
    rdfs:label "provider 1" ;
    RO:0000087 ex:providerRole1 .
ex:providerRole1 a owl:NamedIndividual , OMRSE:00000012 .

ex:encounter1 a owl:NamedIndividual , OGMS:0000097 ;
    rdfs:label "encounter 1" ;
    RO:0000057 ex:patient1 , ex:provider1 .

ex:specimenCollection1 a owl:NamedIndividual , OBI:1110095 ;
    BFO:0000050 ex:encounter1 ;
    RO:0000057 ex:provider1 ;
    OBI:0000293 ex:patient1 ;
    OBI:0000299 ex:specimen1 .

ex:specimen1 a owl:NamedIndividual , OBI:0000655 ;
    rdfs:label "blood specimen 1" .
