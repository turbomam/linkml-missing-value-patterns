# p05 contradiction variant (INTENTIONALLY INCONSISTENT with base.ttl)
#
# LinkML option: none.
#
# Same failed attempt as p05_failed_assay.ttl, but Napoleon is attached with OBI:0000293
# 'has specified input', as most assay records would do. OBI and COB give that property the
# domain COB:0000035 'completely executed planned process', which is disjoint with COB:0000083
# 'failed planned process'. A reasoner therefore reports the graph inconsistent.
# This is the modelling tension discussed in https://github.com/obi-ontology/obi/issues/1230.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/napoleon/> .
@prefix BFO:  <http://purl.obolibrary.org/obo/BFO_> .
@prefix OBI:  <http://purl.obolibrary.org/obo/OBI_> .
@prefix COB:  <http://purl.obolibrary.org/obo/COB_> .

ex:heightAssay1 a owl:NamedIndividual , COB:0000083 ;
    COB:0000085 OBI:0003817 ;
    BFO:0000050 ex:examination1 ;
    OBI:0000293 ex:napoleon .              # domain COB:0000035, disjoint with COB:0000083
