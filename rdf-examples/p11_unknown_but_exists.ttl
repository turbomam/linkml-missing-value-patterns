# p11 unknown but exists: "he had a height, we do not know it"
#
# LinkML option: none. Closest is option2 with a value object present and no reason.
#
# Two forms on two value specifications:
#   valueSpec1: Wikidata style. The object of 'has specified numeric value' is a blank node.
#     In RDF this is well formed; in OWL 2 DL it is not, because OBI:0001937 is a data property
#     and a blank node is not a literal.
#   valueSpec1b: OWL 2 DL form. The node is typed "has specified numeric value some xsd:decimal".
#
# A consumer can infer that a numeric height in metres exists (so this is not p01, p03 or p06),
# and nothing about its magnitude. Compare p08, which adds bounds.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/napoleon/> .
@prefix BFO:  <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO:  <http://purl.obolibrary.org/obo/IAO_> .
@prefix OBI:  <http://purl.obolibrary.org/obo/OBI_> .
@prefix UO:   <http://purl.obolibrary.org/obo/UO_> .

ex:heightAssay1 a owl:NamedIndividual , OBI:0003817 ;
    BFO:0000050 ex:examination1 ;
    OBI:0000293 ex:napoleon ;
    OBI:0000299 ex:heightDatum1 .

ex:heightDatum1 a owl:NamedIndividual , IAO:0000109 ;
    IAO:0000136 ex:napoleonHeight ;
    OBI:0001938 ex:valueSpec1 , ex:valueSpec1b .

# Wikidata-style (RDF only, not OWL 2 DL)
ex:valueSpec1 a owl:NamedIndividual , OBI:0001931 ;
    OBI:0001937 _:someValue ;
    IAO:0000039 UO:0000008 .

# OWL 2 DL form
ex:valueSpec1b a owl:NamedIndividual , OBI:0001931 ,
        [ a owl:Restriction ;
          owl:onProperty OBI:0001937 ;
          owl:someValuesFrom xsd:decimal ] ;
    IAO:0000039 UO:0000008 .
