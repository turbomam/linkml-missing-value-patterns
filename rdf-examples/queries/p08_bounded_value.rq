# p08: value specifications bounded by a datatype restriction instead of a point value, with any detection limit
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX BFO: <http://purl.obolibrary.org/obo/BFO_>
PREFIX RO: <http://purl.obolibrary.org/obo/RO_>
PREFIX IAO: <http://purl.obolibrary.org/obo/IAO_>
PREFIX OBI: <http://purl.obolibrary.org/obo/OBI_>
PREFIX COB: <http://purl.obolibrary.org/obo/COB_>
PREFIX GENEPIO: <http://purl.obolibrary.org/obo/GENEPIO_>
PREFIX NCIT: <http://purl.obolibrary.org/obo/NCIT_>

SELECT ?datum ?vs ?facet ?bound ?lod ?lodValue WHERE {
  ?datum OBI:0001938 ?vs .
  ?vs a ?r .
  ?r owl:onProperty OBI:0001937 ; owl:someValuesFrom ?dt .
  ?dt owl:withRestrictions/rdf:rest*/rdf:first ?f .
  ?f ?facet ?bound .
  FILTER(?facet IN (xsd:maxExclusive, xsd:maxInclusive, xsd:minExclusive, xsd:minInclusive))
  FILTER NOT EXISTS { ?vs OBI:0001937 ?point }
  OPTIONAL { ?datum BFO:0000051 ?lod . ?lod a OBI:0003549 ; OBI:0001937 ?lodValue }
}
