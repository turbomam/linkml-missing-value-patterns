# p10: individuals asserted to have no part of a given type (complement of an existential) or not to have a named part
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX BFO: <http://purl.obolibrary.org/obo/BFO_>
PREFIX RO: <http://purl.obolibrary.org/obo/RO_>
PREFIX IAO: <http://purl.obolibrary.org/obo/IAO_>
PREFIX OBI: <http://purl.obolibrary.org/obo/OBI_>
PREFIX COB: <http://purl.obolibrary.org/obo/COB_>
PREFIX GENEPIO: <http://purl.obolibrary.org/obo/GENEPIO_>
PREFIX NCIT: <http://purl.obolibrary.org/obo/NCIT_>

SELECT ?kind ?subject ?property ?excluded WHERE {
  {
    BIND("complement class" AS ?kind)
    ?subject a ?c .
    ?c owl:complementOf ?r .
    ?r owl:onProperty ?property ; owl:someValuesFrom ?excluded .
  } UNION {
    BIND("negative property assertion" AS ?kind)
    ?npa a owl:NegativePropertyAssertion ;
         owl:sourceIndividual ?subject ;
         owl:assertionProperty ?property ;
         owl:targetIndividual ?excluded .
  }
}
